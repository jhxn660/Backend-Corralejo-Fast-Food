# Copia este archivo como .env (nunca se versiona) y reemplaza los valores.

# Puerto HTTP de la API. La colección de Bruno apunta a 3000.
PORT=3000

# MongoDB. Local:   mongodb://localhost:27017/db_Corralejo-Fast-Food
#          Atlas:   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/db_Corralejo-Fast-Food
URI_MONGO=mongodb://localhost:27017/db_Corralejo-Fast-Food

# Secreto con el que se firman los JWT. Si se filtra, cualquiera puede emitir tokens válidos.
# Genera uno propio:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-64-caracteres

# Orígenes permitidos por CORS, separados por comas. Vacío = cualquier origen (solo desarrollo).
CORS_ORIGIN=http://localhost:5173

# Zona horaria con la que se agrupan las ventas por día en Indicadores.
BUSINESS_TIMEZONE=America/Bogota
